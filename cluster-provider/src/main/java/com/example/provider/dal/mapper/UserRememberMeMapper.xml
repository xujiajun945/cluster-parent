<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.provider.dal.dao.UserRememberMeMapper">

    <resultMap id="BaseResultMap" type="com.example.core.model.UserRememberMe">
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="series" jdbcType="VARCHAR" property="series"/>
        <result column="token" jdbcType="VARCHAR" property="token"/>
        <result column="secret" jdbcType="VARCHAR" property="secret"/>
        <result column="user_id" jdbcType="BIGINT" property="userId"/>
        <result column="created_time" jdbcType="TIMESTAMP" property="createdTime"/>
        <result column="updated_time" jdbcType="TIMESTAMP" property="updatedTime"/>
        <result column="deleted_time" jdbcType="TIMESTAMP" property="deletedTime"/>
        <result column="is_deleted" jdbcType="TINYINT" javaType="Boolean" property="isDeleted"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, series, token, secret, user_id, created_time, updated_time, deleted_time, is_deleted
    </sql>

    <select id="getActiveBySeries" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM
            demo01.user_remember_me
        WHERE
            series = #{series,jdbcType=VARCHAR}
            AND is_deleted = 0
    </select>

    <select id="getActiveByUserId" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM
            demo01.user_remember_me
        WHERE
            user_id = #{userId}
            AND is_deleted = 0
    </select>

    <update id="deleteBySeries" parameterType="java.lang.String">
        UPDATE
            demo01.user_remember_me
        SET
            is_deleted = 1,
            deleted_time = CURRENT_TIMESTAMP()
        WHERE
            series = #{series,jdbcType=VARCHAR}
            AND is_deleted = 0
    </update>

    <insert id="insertSelective" keyColumn="id" keyProperty="id" parameterType="com.example.core.model.UserRememberMe"
            useGeneratedKeys="true">
        INSERT INTO
            demo01.user_remember_me
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="series != null">
                series,
            </if>
            <if test="token != null">
                token,
            </if>
            <if test="secret != null">
                secret,
            </if>
            <if test="userId != null">
                user_id,
            </if>
            <if test="createdTime != null">
                created_time,
            </if>
            <if test="updatedTime != null">
                updated_time,
            </if>
            <if test="deletedTime != null">
                deleted_time,
            </if>
            <if test="isDeleted != null">
                is_deleted,
            </if>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="series != null">
                #{series,jdbcType=VARCHAR},
            </if>
